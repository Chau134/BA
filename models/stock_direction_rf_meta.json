{
  "model_path": "models/stock_direction_rf",
  "feature_columns": [
    "stock_close",
    "oil_price",
    "gold_price",
    "stock_return_pct",
    "oil_return_pct",
    "gold_return_pct",
    "stock_return_lag_1",
    "stock_return_lag_3",
    "stock_return_lag_5",
    "oil_return_lag_1",
    "gold_return_lag_1",
    "stock_ma",
    "oil_ma",
    "gold_ma",
    "stock_volatility",
    "oil_volatility",
    "gold_volatility",
    "rolling_corr",
    "stock_gold_corr",
    "stock_ma_ratio",
    "oil_ma_ratio",
    "gold_ma_ratio"
  ],
  "label_col": "target_market_risk",
  "algorithm": "RandomForestClassifier",
  "prediction_task": "current_market_risk_classification",
  "positive_class": "HIGH RISK",
  "negative_class": "NORMAL",
  "risk_definition": "Current market risk based on return, volatility, correlation and alert level.",
  "symbol_filter": "ALL",
  "train_ratio": 0.8,
  "use_class_weight": false,
  "rf_num_trees": 150,
  "rf_max_depth": 5,
  "rf_min_instances_per_node": 10,
  "pyspark_version": "4.0.2"
}